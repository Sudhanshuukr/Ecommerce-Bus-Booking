# Supabase Project Configuration
# Replace with your actual Supabase Project URL and Anon/Publishable Key from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Development Only Configuration
# Set to "true" only in local development to test without Supabase connectivity.
# MUST NOT be enabled in production (will be ignored in production builds).
# ENABLE_AUTH_MOCK=false
